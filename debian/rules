#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# The SX1262 backend is what the package exists for, so ask for it explicitly
# rather than relying on the platform default: a missing libgpiod should fail
# the build, not silently produce a mock-radio-only binary.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DUMESHCORE_RADIO_SX1262=ON \
		-DUMESHCORE_BUILD_TESTS=ON

# Installing must not start a radio. The frequency is a legal question and a
# 22 dBm PA into an unfitted antenna is a hardware one, so the admin enables
# the unit once /etc/umeshcore/umeshcored.ini is reviewed. Upgrades still
# restart it if they did.
override_dh_installsystemd:
	dh_installsystemd --no-enable
