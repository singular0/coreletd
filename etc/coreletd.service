[Unit]
Description=coreletd MeshCore daemon (uConsole + AIO v2)
Documentation=https://github.com/meshcore-dev/MeshCore
After=network.target
# The radio is useless without SPI; if the overlay did not load, fail loudly.
ConditionPathExists=/dev/spidev1.0

[Service]
Type=exec
ExecStart=/usr/sbin/coreletd --config /etc/coreletd/coreletd.ini --syslog
Restart=on-failure
RestartSec=5

User=coreletd
Group=coreletd

# systemd creates and owns this before start, so it need not be pre-made. It
# holds the node's private key and channel secrets; the group is for the socket
# under /run, not for this, and systemd re-applies the mode on every start.
StateDirectory=coreletd
StateDirectoryMode=0700
RuntimeDirectory=coreletd
RuntimeDirectoryMode=0750

# The daemon needs nothing beyond its own state, SPI and GPIO.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/spidev1.0 rw
DeviceAllow=char-gpiochip rw
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
